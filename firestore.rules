rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().active == true; }
    function admin() { return active() && profile().role == 'admin'; }
    function consultant() { return active() && profile().role == 'consultant'; }
    function requester() { return active() && profile().role == 'requester'; }
    function sameCompany(companyId) { return requester() && profile().companyId == companyId; }
    function consultantCompany(companyId) {
      return consultant() && profile().companyIds is list && companyId in profile().companyIds;
    }
    function ownsDemand(demand) { return sameCompany(demand.companyId); }
    function canReadDemand(demand) { return admin() || ownsDemand(demand) || consultantCompany(demand.companyId); }
    function ownerCandidate() {
      return signedIn()
        && exists(/databases/$(database)/documents/bootstrapConfig/owner)
        && get(/databases/$(database)/documents/bootstrapConfig/owner).data.initialized == false
        && get(/databases/$(database)/documents/bootstrapConfig/owner).data.emailNormalized == request.auth.token.email;
    }
    function validPendingRegistration() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.active == false
        && request.resource.data.registrationStatus == 'pending'
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.emailNormalized == request.auth.token.email
        && request.resource.data.companyIds is list
        && request.resource.data.requestedCompanyIds is list
        && ((request.resource.data.role == 'requester'
          && request.resource.data.companyIds.size() == 0
          && request.resource.data.requestedCompanyIds.size() == 0
          && request.resource.data.companyId is string
          && exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
          && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.active == true)
        || (request.resource.data.role == 'consultant'
          && request.resource.data.companyId == null
          && request.resource.data.companyIds.size() == 0));
    }
    function immutableDemandFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'id', 'code', 'sequence', 'year', 'companyId', 'companyName',
        'requesterId', 'requesterName', 'createdAt', 'createdBy'
      ]);
    }

    match /publicConfig/bootstrap {
      allow get: if true;
      allow list, create, delete: if false;
      allow update: if admin() || ownerCandidate();
    }
    match /bootstrapConfig/owner {
      allow get: if admin() || ownerCandidate();
      allow create, delete: if false;
      allow update: if admin() || ownerCandidate();
    }

    match /users/{uid} {
      allow get: if active() && (admin() || uid == request.auth.uid);
      allow list: if admin();
      allow create: if admin() || validPendingRegistration()
        || (ownerCandidate() && uid == request.auth.uid
          && request.resource.data.role == 'admin'
          && request.resource.data.active == true
          && request.resource.data.registrationStatus == 'approved'
          && getAfter(/databases/$(database)/documents/bootstrapConfig/owner).data.initialized == true
          && getAfter(/databases/$(database)/documents/bootstrapConfig/owner).data.adminUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/publicConfig/bootstrap).data.initialized == true);
      // A consultant never updates their own companyIds. Only an administrator
      // (or trusted Admin SDK code) may change authorizations and permissions.
      allow update: if admin();
      allow delete: if false;
    }

    match /consultantCompanyRequests/{requestId} {
      allow get: if active() && (admin() || resource.data.consultantId == request.auth.uid);
      allow list: if admin();
      allow create: if consultant()
        && request.resource.data.keys().hasOnly([
          'id', 'consultantId', 'consultantName', 'companyId', 'companyName', 'status', 'requestedAt'
        ])
        && request.resource.data.id == requestId
        && requestId == request.auth.uid + '_' + request.resource.data.companyId
        && request.resource.data.consultantId == request.auth.uid
        && request.resource.data.consultantName == profile().name
        && request.resource.data.status == 'pending'
        && request.resource.data.companyId is string
        && exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
        && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.active == true
        && request.resource.data.companyName == get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.legalName;
      allow update: if admin();
      allow delete: if false;
    }

    match /companyRegistrationRequests/{requestId} {
      allow get: if active() && (admin() || resource.data.requestedBy == request.auth.uid);
      allow list: if active() && (admin() || resource.data.requestedBy == request.auth.uid);
      allow create: if consultant()
        && request.resource.data.keys().hasOnly([
          'id', 'requestedBy', 'requestedByName', 'requestedByEmail',
          'company', 'status', 'requestedAt'
        ])
        && request.resource.data.id == requestId
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedByName == profile().name
        && request.resource.data.requestedByEmail == profile().email
        && request.resource.data.status == 'pending'
        && request.resource.data.company is map
        && request.resource.data.company.keys().hasOnly([
          'legalName', 'tradeName', 'cnpj', 'phone', 'email', 'contactName',
          'notes', 'active', 'address'
        ])
        && request.resource.data.company.legalName is string
        && request.resource.data.company.legalName.size() >= 2
        && request.resource.data.company.cnpj is string
        && (request.resource.data.company.cnpj.size() == 0 || request.resource.data.company.cnpj.size() == 14)
        && request.resource.data.company.active == true
        && request.resource.data.company.address is map
        && request.resource.data.company.address.keys().hasOnly([
          'zipCode', 'street', 'number', 'complement', 'neighborhood', 'city', 'state'
        ]);
      allow update: if admin();
      allow delete: if false;
    }

    match /companies/{id} {
      allow get: if active() || resource.data.active == true;
      allow list: if active() || resource.data.active == true;
      allow create, update: if admin();
      allow delete: if false;
    }
    match /uniqueCompanyKeys/{id} { allow read, write: if admin(); }
    match /appConfig/{id} { allow read, write: if admin(); }
    match /levels/{id} { allow read: if active(); allow write: if admin(); }
    match /sectors/{id} {
      // Setores formam um catálogo global. Registros ativos também são
      // públicos para preencher o cadastro inicial antes da autenticação.
      allow read: if admin() || resource.data.active == true;
      allow create, update, delete: if admin();
    }
    match /sectorRequests/{id} {
      allow get: if active() && (admin() || resource.data.requestedBy == request.auth.uid);
      allow list: if active() && (admin() || resource.data.requestedBy == request.auth.uid);
      allow create: if active()
        && (requester() || consultant())
        && request.resource.data.keys().hasOnly(['id', 'name', 'nameNormalized', 'requestedBy', 'requestedByName', 'requestedByRole', 'status', 'requestedAt'])
        && request.resource.data.id == id
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedByName == profile().name
        && request.resource.data.requestedByRole == profile().role
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.nameNormalized is string
        && request.resource.data.nameNormalized.size() >= 2;
      allow update: if admin();
      allow delete: if false;
    }
    match /companyAccess/{id} {
      allow get: if active() && (admin() || resource.data.userId == request.auth.uid);
      allow list: if admin();
      allow create, update, delete: if false;
    }
    match /projectManagerRequests/{id} {
      allow get: if active() && (admin() || resource.data.consultantId == request.auth.uid);
      allow list: if admin();
      allow create, update, delete: if false;
    }
    match /demandStatuses/{id} { allow read: if active(); allow write: if admin(); }

    // Counters and audit records are server-only. Cloud Functions use the
    // Admin SDK and bypass Rules; browser clients cannot forge either record.
    match /counters/{id} { allow read, write: if false; }
    match /auditLogs/{id} { allow read: if admin(); allow create, update, delete: if false; }

    match /demands/{id} {
      allow read: if active() && canReadDemand(resource.data);
      // Spark-plan mode: direct writes remain limited to the owning company
      // or an authorized consultant. Server-side privileged workflows are not
      // enabled until Cloud Functions can be deployed.
      allow create: if active()
        && ((requester() && request.resource.data.companyId == profile().companyId) || consultantCompany(request.resource.data.companyId))
        && exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId))
        && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.active == true
        && request.resource.data.companyName == get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.legalName;
      allow update: if immutableDemandFields() && (admin() || (consultantCompany(resource.data.companyId) && (resource.data.consultantId == request.auth.uid || resource.data.consultantId == null)));
      allow delete: if false;

      match /publicNotes/{note} {
        allow read: if active() && canReadDemand(get(/databases/$(database)/documents/demands/$(id)).data);
        allow create: if active() && canReadDemand(get(/databases/$(database)/documents/demands/$(id)).data); allow update, delete: if false;
      }
      match /internalNotes/{note} {
        allow read: if active() && (admin() || consultantCompany(get(/databases/$(database)/documents/demands/$(id)).data.companyId));
        allow create: if consultantCompany(get(/databases/$(database)/documents/demands/$(id)).data.companyId); allow update, delete: if false;
      }
      match /history/{event} {
        allow read: if active() && canReadDemand(get(/databases/$(database)/documents/demands/$(id)).data);
        allow create: if consultantCompany(get(/databases/$(database)/documents/demands/$(id)).data.companyId); allow update, delete: if false;
      }
      match /attachments/{attachmentId} {
        allow read: if active() && canReadDemand(get(/databases/$(database)/documents/demands/$(id)).data);
        allow write: if false;
      }
    }

    match /notifications/{id} {
      allow get: if active() && (admin() || resource.data.userId == request.auth.uid);
      allow list: if active() && (admin() || resource.data.userId == request.auth.uid);
      allow create: if admin();
      allow update: if active() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if false;
    }
    match /settings/{id} { allow read: if active(); allow write: if admin(); }
  }
}
