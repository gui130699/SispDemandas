rules_version = '2'; service firebase.storage { match /b/{bucket}/o { function signedIn(){return request.auth!=null} function active(){return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active==true} function allowed(){return request.resource.size < 10*1024*1024 && request.resource.contentType.matches('application/(pdf|vnd.openxmlformats-officedocument.*|vnd.ms-excel|json|csv|plain)|image/(png|jpeg|webp)|text/(plain|csv)')} match /demands/{demandId}/{fileName}{allow read: if active(); allow create: if active() && allowed() && fileName.matches('[A-Za-z0-9._-]+'); allow update,delete: if false;}}}
