rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().active == true; }
    function canAccessDemand(demandId) {
      let demand = firestore.get(/databases/(default)/documents/demands/$(demandId)).data;
      return profile().role == 'admin'
        || (profile().role == 'requester' && demand.companyId == profile().companyId)
        || (profile().role == 'consultant' && demand.companyId in profile().companyIds);
    }
    function allowedType() {
      return request.resource.contentType.matches('application/pdf|application/vnd.openxmlformats-officedocument.*|application/vnd.ms-excel|text/plain|text/csv|image/png|image/jpeg|image/webp');
    }
    match /demands/{demandId}/attachments/{attachmentId}/{fileName} {
      allow read: if active() && canAccessDemand(demandId);
      // Upload metadata and object writes will be enabled only together through
      // a privileged attachment Function; direct browser uploads stay blocked.
      allow create, update, delete: if false;
    }
  }
}
